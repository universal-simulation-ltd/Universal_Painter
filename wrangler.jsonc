// Universal Painter — Cloudflare Worker serving static assets only.
//
// A new Universal App starts on Workers static assets, not Pages (standing
// policy, 2026-08-06). The portal Worker proxies
// opensource.unisim.co.uk/painter/* here.
//
// No `main` and no Worker script: Painter has no server side at all. Every
// picture is opened, painted and saved in the browser and never leaves it.
//
// ⚠️ `assets.directory` must NEVER be "." — that uploads .git/ to the edge.
{
  "name": "universal-painter",
  // Hardcoded so CI tokens don't need "User Details: Read" (same as the portal).
  "account_id": "12fb850ff7cd52f3ef0244b1837e3008",
  "compatibility_date": "2026-10-01",
  // Off, as in PalsPayIn since the 2026-10-12 privacy audit: Workers Logs would
  // keep every request, with its IP address, for days. There is nothing here
  // worth logging.
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
