{
  "name": "universal-painter",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Universal Simulation Ltd",
    "email": "inbox@unisim.co.uk"
  },
  "description": "Universal Painter — draw, and do the simple things to a photo, on one canvas in your browser. Closer to Microsoft Paint than Photoshop. Nothing is uploaded and no account is needed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "I18N_STRICT=1 vitest run src/i18n",
    "credits": "node ../scripts/gen-credits.mjs . --repo https://github.com/universal-simulation-ltd/Universal_Painter",
    "icon": "node scripts/app-icon.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@unisim/media": "^0.8.0",
    "@unisim/qr": "^0.1.0",
    "@unisim/sdk": "^0.204.0",
    "heic-to": "^1.6.6",
    "qr-code-styling": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
